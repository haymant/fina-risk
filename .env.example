# fina-risk deployment environment.
# Do not commit real values; configure them in the deployment environment.

# Optional local-only env file (gitignored as .env.local): load_local_env() reads it.

# Host allowlist for the Streamable HTTP MCP endpoint (comma-separated, exact hosts only).
# The mcp DNS-rebinding check accepts exact hostnames plus "host:*" port wildcards;
# it does NOT support subdomain wildcards like *.vercel.app.
# Vercel: set this in Project Settings -> Environment Variables to the deployment
# hostname(s), e.g. fina-risk-zmrl.vercel.app or your production/custom domain,
# otherwise the default list in src/fina_risk/server.py applies.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],localhost:*,127.0.0.1:*,[::1]:*,fina-risk.vercel.app,fina-risk-zmrl.vercel.app

# GCS interoperability credentials for COLD Parquet (see fina-pricer setup).
# WARM recoverable metadata uses Redis; large immutable artifacts use GCS.
S3_API_KEY=
S3_API_SECRET=
S3_BUCKET_NAME=s3://fina-riskcube
S3_ENDPOINT=storage.googleapis.com

# Redis warm-store connection (metadata, job status, cube metadata).
REDIS_URL=redis://localhost:6379/0