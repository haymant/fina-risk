{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"term-sheet-conventions.schema.json",
  "type":"object",
  "required":["product_type","basket","knock_in","call_memory","coupon","settlement","legacy_bumps"],
  "properties":{
    "product_type":{"const":"ELIFCN_KI"},
    "basket":{"type":"object","required":["underlyings","worst_of","performance_normalization"],"properties":{"underlyings":{"type":"array","minItems":2,"items":{"type":"string"}},"worst_of":{"const":true},"performance_normalization":{"const":"close/reference_spot"}}},
    "knock_in":{"type":"object","required":["monitoring","barrier","observation","payoff_on_hit","settlement_type"],"properties":{"monitoring":{"const":"EKI"},"barrier":{"type":"number","description":"Relative final-fixing knock-in barrier, e.g. 0.70."},"observation":{"const":"final_fixing_only"},"payoff_on_hit":{"const":"physical_delivery"},"settlement_type":{"const":"nominal/exercise_price shares of worst asset"},"redemption_cap":{"const":1.0}}},
    "call_memory":{"type":"object","required":["global","barrier","observation","locked_assets","call_condition","accrued_coupon_on_call"],"properties":{"global":{"const":true},"barrier":{"type":"number"},"observation":{"const":"daily_call_fixing"},"locked_assets":{"type":"array","items":{"type":"object","required":["underlying","locked","date"]}},"call_condition":{"const":"all_underlyings_locked"},"accrued_coupon_on_call":{"const":true}}},
    "coupon":{"type":"object","required":["type","indicator","periods","unpaid_period_rule","fixing_count_fields","day_count_rule","range_floor","range_cap","memory_carry","payment_lag_rule","call_accrual_rule"],"properties":{"type":{"const":"range_accrual_strip"},"indicator":{"const":"WPS"},"periods":{"type":"array","items":{"type":"object","required":["period_index","end_date","payment_date","payment_lag_days","total_fixings","paid_fixings","unpaid_fixings","accrued_rate","range_floor","range_cap"],"properties":{"period_index":{"type":"integer"},"end_date":{"type":["integer","string"]},"payment_date":{"type":["integer","string"]},"payment_lag_days":{"type":"integer","minimum":0},"total_fixings":{"type":"integer","minimum":0},"paid_fixings":{"type":"integer","minimum":0},"unpaid_fixings":{"type":"integer","minimum":0},"accrued_rate":{"type":"number"},"range_floor":{"type":"number"},"range_cap":{"type":"number"}}}},"unpaid_period_rule":{"const":"legacy_N2_minus_N1_with_partial_current_period_and_five_full_future_periods"},"full_future_period_count":{"const":5},"partial_current_period":{"const":true},"fixing_count_fields":{"type":"object","required":["paid","total","unpaid"],"properties":{"paid":{"const":"N1"},"total":{"const":"N2"},"unpaid":{"const":"N2-N1"}}},"day_count_rule":{"const":"days_in/total_days"},"range_floor":{"type":"number"},"range_cap":{"type":"number"},"memory_carry":{"const":true},"payment_lag_rule":{"const":"paymentDate minus endDate per period; final lag is applied after final fixing"},"call_accrual_rule":{"const":"accrue unpaid in-range fixings through call and pay at call/payment date"},"legacy_quote_scale":{"const":10.0}}},
    "settlement":{"type":"object","required":["currency","notional_return_leg","physical_delivery_leg"],"properties":{"currency":{"type":"string"},"notional_return_leg":{"type":"boolean"},"physical_delivery_leg":{"type":"boolean"},"fractional_shares":{"const":"cash"}}},
    "legacy_bumps":{"type":"object","required":["amount_is_absolute_quote_delta","relative_size","quoted_spot_source","common_random_numbers"],"properties":{"amount_is_absolute_quote_delta":{"const":true},"relative_size":{"const":0.01},"quoted_spot_source":{"const":"marketData.equity[].spot"},"reference_spot_excluded":{"const":true},"common_random_numbers":{"const":true},"data_type":{"const":1}}},
    "legacy_fields":{"type":"object","description":"Lossless semantic retention of Chunk/Jobs/commonData/Tasks/dealData.","additionalProperties":true}
  }
}
